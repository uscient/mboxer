# NOTE: mboxer does not currently read environment variables. The entries below
# are reserved placeholders only. Until env-var support is implemented:
#   - Ollama settings live in config under classification.ollama.* (and LLM
#     classification is not yet wired into the pipeline regardless).
#   - Select the config file with `mboxer --config PATH`
#     (default: config/mboxer.example.yaml).
#   - Select the database with `mboxer --db PATH` or paths.database in config
#     (default: var/mboxer.sqlite).

# Reserved (not yet read) — optional local LLM settings
MBOXER_OLLAMA_ENDPOINT=http://localhost:11434/api/generate
MBOXER_OLLAMA_MODEL=llama3.1:8b

# Reserved (not yet read) — optional defaults
MBOXER_CONFIG=config/mboxer.yaml
MBOXER_DB=var/mboxer.sqlite
